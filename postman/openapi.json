{
  "openapi": "3.0.3",
  "info": {
    "title": "Autenticación grupo 1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3001"
    }
  ],
  "paths": {
    "/auth/registro": {
      "post": {
        "summary": "Registrar usuario del grupo 1",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "nombres",
                  "correo",
                  "clave"
                ],
                "properties": {
                  "correo": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "clave": {
                    "type": "string",
                    "minLength": 12,
                    "description": "Máximo 72 bytes UTF-8",
                    "writeOnly": true
                  },
                  "nombres": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "apellidos": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "celular": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  "tipoDocumento": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  },
                  "numeroDocumento": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario UUID y perfil creados en una transacción; devuelve id, correo, creadoEn y perfil, sin clave"
          },
          "400": {
            "description": "Datos o JSON inválidos"
          },
          "409": {
            "description": "Correo o documento ya registrado"
          },
          "413": {
            "description": "Cuerpo mayor de 16 KB"
          },
          "429": {
            "description": "Más de 20 intentos por IP en 15 minutos"
          },
          "503": {
            "description": "Registro no disponible"
          },
          "403": {
            "description": "Origen del frontend no autorizado"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Iniciar sesión con correo y clave",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "correo",
                  "clave"
                ],
                "properties": {
                  "correo": {
                    "type": "string",
                    "format": "email"
                  },
                  "clave": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Máximo 72 bytes UTF-8"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token JWT válido por 2 horas y datos públicos del usuario"
          },
          "400": {
            "description": "Datos inválidos"
          },
          "401": {
            "description": "Credenciales inválidas o cuenta no activa"
          },
          "429": {
            "description": "Demasiados intentos"
          },
          "503": {
            "description": "Servicio no disponible"
          },
          "403": {
            "description": "Origen del frontend no autorizado"
          }
        }
      }
    },
    "/auth/perfil": {
      "get": {
        "summary": "Consultar perfil del usuario autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "id, correo, creadoEn y perfil del usuario"
          },
          "401": {
            "description": "Token inválido, vencido o usuario no activo"
          },
          "503": {
            "description": "Servicio no disponible"
          },
          "403": {
            "description": "Origen del frontend no autorizado"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Comprobar disponibilidad del backend y PostgreSQL",
        "responses": {
          "200": {
            "description": "status: ok"
          },
          "503": {
            "description": "status: unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
